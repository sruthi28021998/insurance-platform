generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  // If role = CUSTOMER, this links to their customer profile
  customer Customer?
}

model Customer {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dob       DateTime?
  phone     String?
  address   String?
  email     String
  createdAt DateTime  @default(now())

  policies  Policy[]
  documents Document[]
}

model Policy {
  id            Int          @id @default(autoincrement())
  customerId    Int
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyType    String
  policyNumber  String       @unique
  premiumAmount Float
  startDate     DateTime
  endDate       DateTime
  status        PolicyStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())

  claims          Claim[]
  premiumPayments PremiumPayment[]
}

model Claim {
  id             Int         @id @default(autoincrement())
  policyId       Int
  policy         Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claimAmount    Float
  reason         String
  status         ClaimStatus @default(PENDING)
  submissionDate DateTime    @default(now())
  reviewedBy     Int?
  reviewNotes    String?

  documents Document[]
}

model PremiumPayment {
  id            Int           @id @default(autoincrement())
  policyId      Int
  policy        Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  paymentDate   DateTime      @default(now())
  amount        Float
  paymentStatus PaymentStatus @default(PENDING)
}

model Document {
  id         Int       @id @default(autoincrement())
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  claimId    Int?
  claim      Claim?    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  uploadedAt DateTime  @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum DocumentType {
  IDENTITY
  POLICY
  CLAIM
  OTHER
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  customer  Customer?
}

model Customer {
  id        Int       @id @default(autoincrement())
  userId    Int?      @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dob       DateTime?
  phone     String?
  address   String?
  email     String
  createdAt DateTime  @default(now())

  policies  Policy[]
  documents Document[]
}

model Policy {
  id            Int          @id @default(autoincrement())
  customerId    Int
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyType    String
  policyNumber  String       @unique
  premiumAmount Float
  startDate     DateTime
  endDate       DateTime
  status        PolicyStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())

  claims          Claim[]
  premiumPayments PremiumPayment[]
}

model Claim {
  id              Int         @id @default(autoincrement())
  policyId        Int
  policy          Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claimAmount     Float
  reason          String
  status          ClaimStatus @default(PENDING)
  submissionDate  DateTime    @default(now())
  reviewedBy      Int?
  reviewNotes     String?
  assignedAgentId Int?

  documents Document[]
}

model PremiumPayment {
  id            Int           @id @default(autoincrement())
  policyId      Int
  policy        Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  dueDate       DateTime      @default(now())
  paymentDate   DateTime      @default(now())
  amount        Float
  paymentStatus PaymentStatus @default(PENDING)
}

model Document {
  id           Int          @id @default(autoincrement())
  customerId   Int?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  claimId      Int?
  claim        Claim?       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  documentType DocumentType @default(OTHER)
  fileName     String
  filePath     String
  uploadedAt   DateTime     @default(now())
}

model Settings {
  id                     Int      @id @default(1)
  companyName            String   @default("Insurance Management Platform")
  claimApprovalThreshold Float    @default(50000)
  updatedAt              DateTime @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  entityType  String
  entityId    Int
  action      String
  performedBy Int
  details     String?
  createdAt   DateTime @default(now())
}

model SmsLog {
  id       Int      @id @default(autoincrement())
  policyId Int
  phone    String
  message  String
  status   String   @default("SENT")
  sentAt   DateTime @default(now())
}

model EmailLog {
  id       Int      @id @default(autoincrement())
  policyId Int
  toEmail  String
  subject  String
  status   String   @default("SENT")
  sentAt   DateTime @default(now())
}
